def _xdg(var: str, default: str) -> Path:
    return Path(os.environ.get(var) or Path.home() / default)


CONFIG_DIR = _xdg("XDG_CONFIG_HOME", ".config") / "i3status-rs-ai-usage"
CONFIG_PATH = CONFIG_DIR / "config.json"
CACHE_DIR = _xdg("XDG_CACHE_HOME", ".cache") / "i3status-rs-ai-usage"
CACHE_PATH = CACHE_DIR / "state.json"
LOCK_PATH = CACHE_DIR / "poll.lock"

CLAUDE_CREDENTIALS = Path.home() / ".claude" / ".credentials.json"
CODEX_SESSIONS = Path.home() / ".codex" / "sessions"
COPILOT_APPS = _xdg("XDG_CONFIG_HOME", ".config") / "github-copilot" / "apps.json"


